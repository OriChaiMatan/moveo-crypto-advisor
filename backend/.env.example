# Copy this file to backend/.env and fill in the real values.
# Never commit the real .env file.

NODE_ENV=development
PORT=5001

# MongoDB Atlas connection string, including the credentials
DB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
DB_NAME=crypto-advisor

# A long random string. Changing it signs every existing user out.
JWT_SECRET=replace-with-a-long-random-string

# Where the frontend runs, used for CORS and for the cookie
CLIENT_URL=http://localhost:5173
